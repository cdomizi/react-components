{
  "name": "react-components",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "ts-lint": "tsc",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint . --debug --report-unused-disable-directives --max-warnings 0 .",
