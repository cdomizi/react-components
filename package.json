    "css-mediaquery": "^0.1.2",
    "json-server": "1.0.0-beta.2",
    "nanoid": "^5.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-router-dom": "^6.26.2",
    "tsx": "^4.19.1",
    "zod": "^3.23.8"
